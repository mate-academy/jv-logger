<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

    <appender name="LogToConsole" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{HH:mm:ss.SSS} [%t] %-5p %c{1} - %m%n"/>
        </layout>
    </appender>

    <appender name="LogToFile" class="org.apache.log4j.FileAppender">
        <param name="File" value="logs/app.log"/>
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d %p %c:%L %m%n"/>
        </layout>
    </appender>

    <logger name="mate.academy" additivity="false">
        <level value="info"/>
        <appender-ref ref="LogToConsole"/>
        <appender-ref ref="LogToFile"/>
    </logger>

    <root>
        <priority value="error"/>
        <appender-ref ref="LogToConsole"/>
        <appender-ref ref="LogToFile"/>
    </root>

</log4j:configuration>